{
  "name": "jobtrace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mjs,json}\" .github README.md docs",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mjs,json}\" .github README.md docs",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "db": "uv run --cache-dir .uv-cache --with psycopg[binary]==3.2.9 python scripts/db_migrate.py",
    "db:test": "uv run --cache-dir .uv-cache --with psycopg[binary]==3.2.9 python scripts/db_verify.py",
    "db:types": "uv run --cache-dir .uv-cache --with psycopg[binary]==3.2.9 python scripts/db_types.py",
    "db:reset:verify": "uv run --cache-dir .uv-cache --with psycopg[binary]==3.2.9 python scripts/db_reset_verify.py",
    "admin:bootstrap": "uv run --cache-dir .uv-cache --with psycopg[binary]==3.2.9 python scripts/bootstrap_admin.py",
    "contract": "playwright test --config playwright.contract.config.ts",
    "integration": "playwright test --config playwright.integration.config.ts",
    "e2e": "playwright test",
    "performance": "uv run --cache-dir .uv-cache --with psycopg[binary]==3.2.9 python tests/performance/application_performance.py",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "better-auth": "^1.6.27",
    "date-fns": "^4.1.0",
    "next": "^16.0.0",
    "pg": "^8.23.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.34.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-import-x": "^4.16.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
