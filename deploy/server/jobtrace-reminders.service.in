[Unit]
Description=Deliver due JobTrace reminders
After=network-online.target jobtrace.service
Wants=network-online.target
Requires=jobtrace.service

[Service]
Type=oneshot
User=@@APP_USER@@
Group=@@APP_GROUP@@
EnvironmentFile=@@ENV_FILE@@
Environment=JOBTRACE_REMINDER_URL=http://127.0.0.1:@@APP_PORT@@
RuntimeDirectory=jobtrace-reminders
ExecStart=@@REMINDER_BIN@@
TimeoutStartSec=50s
UMask=0077
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
