[Unit]
Description=Back up the JobTrace PostgreSQL database
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
ExecStart=@@BACKUP_BIN@@
TimeoutStartSec=30min
UMask=0077
Nice=10
# 允许写备份目录，其余文件系统保持只读
ProtectSystem=full
ReadWritePaths=/var/backups/jobtrace
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
