# Runtime
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000

# PostgreSQL 17. Percent-encode reserved characters in the password.
DATABASE_URL=postgresql://jobtrace:replace-with-database-password@127.0.0.1:5432/jobtrace
DATABASE_APP_POOL_MAX=8
DATABASE_AUTH_POOL_MAX=2

# Authentication
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://jobtrace.example.com

# Automated recruitment synchronization
JOB_MARKET_ENABLED=true
JOB_MARKET_SYNC_SECRET=replace-with-another-at-least-32-character-secret
JOB_MARKET_SYNC_BATCH_SIZE=10
JOB_MARKET_FETCH_TIMEOUT_MS=12000
JOB_MARKET_MAX_RESPONSE_BYTES=5242880
JOB_MARKET_WORKER_ID=jobtrace-production
JOB_MARKET_ALLOW_PROXY_DNS=false

# Registration verification and password recovery
AUTH_EMAIL_DELIVERY_URL=
AUTH_EMAIL_DELIVERY_SECRET=

# Optional Tencent Cloud COS avatar storage
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=
