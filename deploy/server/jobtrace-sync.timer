[Unit]
Description=Run JobTrace recruitment synchronization every six hours

[Timer]
OnCalendar=*-*-* 00:17:00 Asia/Shanghai
OnCalendar=*-*-* 06:17:00 Asia/Shanghai
OnCalendar=*-*-* 12:17:00 Asia/Shanghai
OnCalendar=*-*-* 18:17:00 Asia/Shanghai
Persistent=true
RandomizedDelaySec=120
Unit=jobtrace-sync.service

[Install]
WantedBy=timers.target
