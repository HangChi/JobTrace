# Required: server-only PostgreSQL connection and Better Auth settings.
DATABASE_URL=postgresql://username:password@127.0.0.1:5432/jobtrace
# 单个应用实例的连接池预算；默认业务 8、认证 2，总计 10 条连接。
DATABASE_APP_POOL_MAX=8
DATABASE_AUTH_POOL_MAX=2
# Generate a local value with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Must match the origin opened in the browser; use HTTPS in production.
BETTER_AUTH_URL=http://localhost:3000

# Automated job market. Keep the sync secret server-only and rotate it when a
# scheduler credential may have been exposed.
JOB_MARKET_ENABLED=false
JOB_MARKET_SYNC_SECRET=replace-with-at-least-32-random-characters
JOB_MARKET_SYNC_BATCH_SIZE=10
JOB_MARKET_FETCH_TIMEOUT_MS=12000
JOB_MARKET_MAX_RESPONSE_BYTES=5242880
JOB_MARKET_WORKER_ID=jobtrace-local

# Optional CAPTCHA-compatible verification. Configure both values when enabled;
# clients must then send the provider token in x-auth-challenge.
AUTH_CHALLENGE_VERIFY_URL=
AUTH_CHALLENGE_SECRET=

# Required in production for registration verification and password recovery.
# JobTrace sends password_reset or email_verification_code JSON payloads.
AUTH_EMAIL_DELIVERY_URL=
AUTH_EMAIL_DELIVERY_SECRET=
# Test runners only. Never set this in production.
AUTH_EMAIL_VERIFICATION_TEST_CODE=

# Optional Tencent Cloud COS avatar upload. All four required values below are
# needed only when avatar uploads are enabled. Keep credentials server-only.
COS_SECRET_ID=replace-with-cos-secret-id
COS_SECRET_KEY=replace-with-cos-secret-key
COS_BUCKET=project-1308913859
COS_REGION=ap-shanghai
# Optional custom/public CDN base URL; leave empty to use the COS origin.
COS_PUBLIC_BASE_URL=https://project-1308913859.cos.ap-shanghai.myqcloud.com
